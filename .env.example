# AI Gateway Suite LAB reads the ONE shared settings file ~/Development/.env (STANDALONE_ENV overrides
# the path); nothing Real-mode lives here. This file is comments only — copy nothing real into it.

# Allowed range 5750-5759, default 5750.
#PORT=5750
# GWS_BIND=0.0.0.0  # opt-in only; Docker sets this itself

# Host names (besides loopback) the lab answers to, e.g. local.ping-devops.com (must point at this Mac).
#LAB_ALLOWED_HOSTS=local.ping-devops.com

# Real mode (rule 19) is configured from the shared settings file ~/Development/.env, not here:
#   CENTRAL_AGENT_A2A_URL=https://<central-agent-host>/a2a
#   CENTRAL_AGENT_A2A_BEARER=<bearer key, write-only: never returned by any API>
#   WORKER_TRACE_URL=https://<optional SSE trace relay>
# With no URL set the Real button is disabled with a how-to tooltip and the in-process mock agent
# answers everything in Mock mode (default).
